# The interop clients' Python modules: the dependencies of PyKMIP, which
# scripts/test_interop.py installs from its pinned commit (interop/clients.lock.json)
# with --no-deps --no-build-isolation, so setuptools, its build backend, is here too.
# After a change, regenerate the lock, requirements.txt: python3 scripts/python_env.py lock
cryptography
enum-compat
requests
setuptools
six
SQLAlchemy
