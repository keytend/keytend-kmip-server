     "agrees": false
    },
    {
     "trace": "1.4|test-cases/kmip-v1.4/mandatory/CS-BC-M-6-14.xml",
     "computed": "d9bcce11b0b437b90239552df3a360c9",
     "trace_expects": "d9bcce11b0b437b90239552df3a360c9",
     "agrees": true
    }
   ]
  },
  {
   "family": "pss-sample-contradicts-default-table",
   "shows": "The sample PSS signature verifies only with MGF1-SHA-256 and a 222-byte salt. The Cryptographic Parameters defaults are MGF1-SHA-1 and a salt of the MGF hash block size (64 bytes); no default reading (20, 32 or 64 bytes, either MGF hash) verifies.",
   "evidence": [
    {
     "trace": "1.4|test-cases/kmip-v1.4/mandatory/CS-AC-M-2-14.xml",
     "verifies": {
      "MGF1-SHA1 salt 20": false,
      "MGF1-SHA1 salt 32": false,
      "MGF1-SHA1 salt 64": false,
      "MGF1-SHA1 salt 222": false,
      "MGF1-SHA256 salt 20": false,
      "MGF1-SHA256 salt 32": false,
      "MGF1-SHA256 salt 64": false,
      "MGF1-SHA256 salt 222": true
     }
    },
    {
     "trace": "2.0|test-cases/kmip-v2.0/mandatory/CS-AC-M-2-20.xml",
