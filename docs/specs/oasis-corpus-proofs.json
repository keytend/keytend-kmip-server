  {
   "family": "shared-digest-placeholder-3.0",
   "shows": "One placeholder names the SHA-256 digests of both the private and the public key, which are different objects with different key material; the trace itself uses distinct placeholders for their Short Unique Identifiers.",
   "evidence": {
    "trace": "3.0|test-cases/kmip-v3.0/optional/AKLC-O-1-30.xml",
    "uses": [
     {
      "message": 3,
      "object": "$UNIQUE_IDENTIFIER_0",
      "placeholder": "$DIGEST_VALUE"
     },
     {
      "message": 7,
      "object": "$UNIQUE_IDENTIFIER_0",
      "placeholder": "$DIGEST_VALUE"
     },
     {
      "message": 9,
      "object": "$UNIQUE_IDENTIFIER_1",
      "placeholder": "$DIGEST_VALUE"
     },
     {
      "message": 13,
      "object": "$UNIQUE_IDENTIFIER_1",
      "placeholder": "$DIGEST_VALUE"
     }
    ]
   }
  },
  {
   "family": "aes-ecb-sample-1.3",
   "shows": "AES-128-ECB of the trace plaintext under the trace key differs from the 1.3 sample and equals the 1.4 sample.",
   "evidence": [
    {
     "trace": "1.3|test-cases/kmip-v1.3/mandatory/CS-BC-M-6-13.xml",
