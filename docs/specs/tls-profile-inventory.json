{
  "description": "Curated inventory of KMIP authentication-suite TLS requirements read from pinned primary profiles. Paraphrased; section numbers refer to each Profiles document. Not a TC ruling and not a product decision.",
  "naming": "Cipher suites use IANA names. The 2.0-3.0 documents spell TLS 1.3 suites as TLS13-CHACHA20-POLY1305-SHA256 and TLS13-AES-256-GCM-SHA384; this inventory maps them to the RFC 8446 names TLS_CHACHA20_POLY1305_SHA256 and TLS_AES_256_GCM_SHA384 (mapping is an interpretation of the spelling).",
  "base_specification_clauses": [
    {
      "edition": "1.0",
      "section": "10 Transport",
      "paraphrase": "Server SHALL provide channel confidentiality, integrity and server authenticity; over TCP/IP it SHALL support TLS v1.0 or later and may support other protocols in [KMIP-Prof].",
      "sha256": "c024b3fdff7fc5b55512f2e6c0b18eb7edb61d5b5560b90cf6c60720d703fcb3"
    },
    {
      "edition": "1.0",
      "section": "8 Authentication",
      "paraphrase": "Server SHALL support authentication as defined in [KMIP-Prof]."
    },
    {
      "edition": "1.1-1.4",
      "section": "8 Authentication; 10 Transport",
      "paraphrase": "Authentication is external to the messages; server SHALL support authentication and channel security as specified in [KMIP-Prof]."
    },
    {
      "edition": "2.0-3.0",
      "section": "10.3 Authentication; 10.4 Transport",
      "paraphrase": "Same delegation to [KMIP-Prof]."
    },
    {
      "edition": "errata",
      "section": "1.1 errata01, 1.4 errata01",
      "paraphrase": "Neither pinned errata document changes TLS, cipher-suite or authentication-suite text (no TLS/cipher/SSL mention found).",
